# ============================================================
#  ENVIRONMENT VARIABLES  -  Kashyap Tutorial & Home Tuition
# ============================================================
# Copy this file to ".env.local" and fill in your real values.
# On Vercel, add these in: Project Settings -> Environment Variables.

# --- Web3Forms (Contact form -> your email) ---
# Get your FREE key at https://web3forms.com (enter your email, they email you a key)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY_HERE

# --- Site URL (used for SEO / sitemap / canonical URLs) ---
# When deployed: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
